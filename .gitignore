# build output and release packages
build/
out/
dist/
*.obj
*.pdb
*.ilk
*.exp
*.lib
*.dll
*.exe
*.zip
*.log
*.map

# IDE and local CMake state
.vs/
.vscode/
.idea/
CMakeUserPresets.json
CMakeSettings.json

# renders and test dumps
*.bmp
*.bin
captures/
__pycache__/

# NVIDIA's DLSS SDK is not redistributable: download it yourself (addons/Upscalers/external/ngx/README.md)
addons/Upscalers/external/ngx/*
!addons/Upscalers/external/ngx/README.md

# Private implementation notes, research, machine captures and local handoffs.
/ROADMAP.md
/docs/*
!/docs/addon-authors.md
!/docs/api-compatibility.md
!/docs/faq.md
!/docs/images/
/docs/images/*
!/docs/images/build-1-manager.png
!/docs/images/about.png
!/docs/images/addons.png
!/docs/images/banner.svg
!/docs/images/features.png
!/docs/images/hud-editor.png
!/docs/images/neural-rendering-panel.png
!/docs/images/performance.png
!/docs/images/runtimes.png
!/docs/images/settings.png
!/docs/images/setup-install.png
!/docs/images/setup-installed.png
!/docs/images/shf-neural-rendering.jpg
!/docs/images/shf-original.jpg
!/docs/images/upscaler.png
/addons/*/docs/architecture.md
/addons/*/docs/building.md
/addons/*/docs/dlssnr-knobs.md
/handoff/
/testing/
/profiles/
/tools/local-build-lock.json

# Local credentials, session state and diagnostic recordings.
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.lsrec
.agents/
.codex/
.aws/
# anything else dropped into external/ (SDK drops, snippets) stays out of the repo
addons/Upscalers/external/*
!addons/Upscalers/external/ngx/
build_setup/
imgui.ini

# the tools' own Python environment (tools\depth_maps.py)
tools/.venv/

# Vendor SDKs stay local in every addon source tree.
addons/*/external/*
!addons/Upscalers/external/ngx/
addons/Upscalers/external/ngx/*
!addons/Upscalers/external/ngx/README.md
